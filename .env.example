# AEDEXA settings. Copy to .env and fill in your keys.
# .env itself is never committed (.gitignore: .env*).

# Featherless (OpenAI-compatible API) - the model for 2D -> 3D and label parsing.
# The service can send errors with HTTP 200, does not support strict JSON schema,
# and the model is sometimes busy - the code handles all of this.
FEATHERLESS_API_KEY=
# Backup key: used only when the model is temporarily busy.
FEATHERLESS_API_KEY_2=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=Qwen/Qwen3-VL-32B-Instruct

# How many characters of drawing context to send to the model per step.
RECONSTRUCTION_AI_CONTEXT_LENGTH=48000
